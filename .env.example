# 复制为 .env 后填真实值。密钥只放本地，不要提交。

# ---------- 数据库 ----------
# 一个库，身份与模块分 schema；`mod_vector_li` 是 vector-rag 的 LlamaIndex 子存储。
# 每个模块用自己的连接池并锁死 search_path —— 将来可按模块拆库。
# macOS + Homebrew PostgreSQL 通常就是你的系统用户名，无密码。
DATABASE_URL=postgres://myx@localhost:5432/minibrain

# ---------- Embedding ----------
# openai-compatible 接口。OpenRouter / 硅基流动 / 官方直连都走这里。
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=<your-api-key>
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# 目标维度。qwen3-embedding-8b 实际输出 4096 维，代码会做 MRL 截断 + 重新归一化降到这个值
# （和 ff-companybrain 同口径），省 4 倍内存和存储。
# 「截断后检索质量掉多少」本项目还没测过，见 eval/RESULTS.md 的"还没测的"一节。
# 模型输出小于这个值时直接报错——维度编不出来。改这个值必须重新索引全部文档。
EMBEDDING_DIMENSIONS=1024

# ---------- Agent LLM ----------
# BASE_URL / MODEL / API_KEY 三者必须同源：
#   OpenRouter  → base=https://openrouter.ai/api/v1  model=deepseek/deepseek-chat（带前缀）
#   官方直连     → base=https://api.deepseek.com/v1  model=deepseek-chat（无前缀）
# 混搭会 404。
AGENT_BASE_URL=https://openrouter.ai/api/v1
AGENT_API_KEY=<your-api-key>
AGENT_MODEL=deepseek/deepseek-chat
# 离线回答质量评测专用；正式报告应与 AGENT_MODEL 不同。
# 未配置时 eval_answer_quality 会沿用 Agent 配置，但
# --require-independent-judge 会拒绝同模型自评。
JUDGE_BASE_URL=https://openrouter.ai/api/v1
JUDGE_API_KEY=<your-judge-api-key>
JUDGE_MODEL=<independent-judge-model>
AGENT_TEMPERATURE=0
# tool loop 最多来回几轮，防跑飞
AGENT_MAX_STEPS=6
# 只计算检索证据，不含 system prompt / 会话历史。使用 cl100k_base 做固定、可复现的口径。
AGENT_EVIDENCE_TOKEN_BUDGET=4000
# 即使短片段很多，也最多给最终模型这些证据，防止 top_k 被模型随意放大。
AGENT_EVIDENCE_LIMIT=12
# Agent 向量检索先多召回候选，再由上下文组装器在预算内选择。
AGENT_CONTEXT_CANDIDATE_POOL=12

# ---------- 出站 HTTP 超时（别设成 0，见下）----------
#
# ★ 这几行是踩出来的，不是抄的。三处 OpenAI 客户端原本都没设超时，
#   SDK 默认 600 秒 + 2 次重试，结果一次 194 调用的评测**挂死了 13 小时**：
#   进程活着、CPU 只用了 14.7 秒，全程在等一个永远不返回的响应。
#   `except Exception` 挡得住「调用失败」，挡不住「调用不返回」——
#   那是两种故障，超时是后者唯一的防线。设 0 或负数会被 config.py 拒绝启动。
#
# 对话类（agent）：单次问答，60 秒还不回基本就是挂了
LLM_TIMEOUT_SECONDS=60
# embedding：一次要批量编码几百个片段，给宽一些
EMBEDDING_TIMEOUT_SECONDS=180
# SDK 自带重试次数。设 1 而不是默认的 2 —— 重试会把最坏耗时翻倍，
# 而这些调用都不在幂等关键路径上，快速失败比慢慢重试有用。
LLM_MAX_RETRIES=1

# ---------- 切分（这两个值是消融测出来的，不是拍的）----------
#
# 网格实测（scripts/ablate_chunking.py，130 篇 / 58 题，两把尺子结论一致）：
#
#   size    CompRec@5(固定k)  CompRec@5(等预算)
#   300         0.672            0.707
#   500         0.672            0.707
#   800         0.707            0.741    ← 最优
#   1200        0.603            0.621    ← 明显最差
#
# 1200 差在哪：同样 2400 字的上下文预算只装得下 15.3 个片段（800 能装 22.4 个），
# 独立文档覆盖不全。它的 MRR 反而最高（0.966）——块大了第一个相关文档排得更靠前，
# 但覆盖面塌了。标准 Recall 和 MRR 都看不见这个失败，Complete Recall 才看得见。
CHUNK_SIZE=800
#
# ★ overlap 设 0，这是反直觉但测出来的。固定 size=800 只动 overlap：
#
#   overlap   片段数   CompRec@5   NDCG@5    MRR
#     0        830      0.741      0.910    0.966   ← 最优，且片段最少
#     120      900      0.741      0.897    0.940
#     240     1020      0.741      0.896    0.940
#
# overlap 对 Complete Recall **完全没有影响**，但排序质量反而是 0 最好，
# 而且片段数少 8%（存储和 embedding 都更省）。
#
# 为什么和「overlap 10~15%」的通行建议相反：overlap 的作用是补救「切在句子中间」，
# 而本项目的 split_text 是**按段落对齐**的（先按空行聚合整段，只有单段超长才硬切），
# 语义边界本来就没被破坏，overlap 没活干；反而制造出内容高度重复的相邻片段，
# 它们互相竞争 top-k 名额，挤掉本该进来的其他文档。
#
# ⚠ 这个结论**依赖切分实现**。如果语料换成 PDF 抽取那种没有段落标记的文本，
#   overlap 大概率会重新变得有价值。别直接抄这个 0。
CHUNK_OVERLAP=0
# small-to-big：800 字子块负责召回；命中后展开到 1600 字父块给最终模型。
# 父块单独存储且不做 embedding，因此不会增加向量 API 成本。
PARENT_CHUNK_SIZE=1600
# 58 题受控消融：展开 parent 未提升关键答案支持率，token 中位数却 +469；默认关闭。
# parent_id 仍用于 child 去重（Recall@5 0.847 → 0.886），不受此开关影响。
EXPAND_PARENT_CONTEXT=false

# ---------- 表格模块只读查询护栏 ----------
TABLE_QUERY_TIMEOUT_MS=5000
TABLE_QUERY_MAX_ROWS=200

# ---------- 持久化入库 worker ----------
# Web 只登记任务；`uv run minibrain-worker` 从 PostgreSQL 原子领取。
INGEST_MAX_ATTEMPTS=3
# 单篇文档处理 lease。worker 崩溃后，超过这个时间的 processing 任务可被重新领取。
INGEST_LEASE_SECONDS=3600
# 临时故障按 5s、10s、20s 指数退避。
INGEST_RETRY_BASE_SECONDS=5
INGEST_POLL_SECONDS=1
AGENT_RUN_STALE_SECONDS=900
# Web/Core 最多读取 20 MiB + 1 字节做超限判断；超限文档会留下 failed 记录。
UPLOAD_MAX_BYTES=20971520

# ---------- 会话 ----------
SESSION_TTL_HOURS=168
# 完整历史仍保存在 PostgreSQL；以下限制只控制每次实际发送给模型的最近对话，
# 不调用额外摘要模型。按完整 turn 裁剪，避免拆断 AI tool_call / ToolMessage 协议。
AGENT_HISTORY_MAX_TURNS=6
AGENT_HISTORY_TOKEN_BUDGET=8000
